<file path="src/test/java/com/ecommerce/analytics/spark/batch/ProductPopularityAnalyticsTest.java">
package com.ecommerce.analytics.spark.batch;

import com.ecommerce.analytics.spark.SparkTestSupport;
import org.apache.spark.sql.Dataset;
import org.apache.spark.sql.Row;
import org.apache.spark.sql.RowFactory;
import org.apache.spark.sql.types.DataTypes;
import org.apache.spark.sql.types.Metadata;
import org.apache.spark.sql.types.StructField;
import org.apache.spark.sql.types.StructType;
import org.junit.jupiter.api.Test;

import java.sql.Timestamp;
import java.time.Instant;
import java.util.List;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertThrows;
import static org.junit.jupiter.api.Assertions.assertTrue;

/**
 * Separate test class (not appended to the existing BatchAnalyticsTest) to
 * avoid rewriting a large existing test file blind - same fixture style
 * (schema()/utc() helpers, RowFactory rows) as BatchAnalyticsTest, just
 * local to this class.
 */
class ProductPopularityAnalyticsTest extends SparkTestSupport {

    private static final double HALF_LIFE_DAYS = 10.0;
    private static final Timestamp NOW = utc("2026-09-20T00:00:00Z");

    private static Timestamp utc(String isoInstant) {
        return Timestamp.from(Instant.parse(isoInstant));
    }

    private static StructType schema(Object... nameTypePairs) {
        StructField[] fields = new StructField[nameTypePairs.length / 2];
        for (int i = 0; i < nameTypePairs.length; i += 2) {
            fields[i / 2] = new StructField(
                    (String) nameTypePairs[i],
                    (org.apache.spark.sql.types.DataType) nameTypePairs[i + 1],
                    true, Metadata.empty());
        }
        return new StructType(fields);
    }

    private Dataset<Row> orders(Row... rows) {
        StructType schema = schema(
                "id", DataTypes.LongType,
                "user_id", DataTypes.LongType,
                "total_amount", DataTypes.DoubleType,
                "status", DataTypes.StringType,
                "payment_status", DataTypes.StringType,
                "created_at", DataTypes.TimestampType
        );
        return spark.createDataFrame(List.of(rows), schema);
    }

    private Dataset<Row> orderItems(Row... rows) {
        StructType schema = schema(
                "id", DataTypes.LongType,
                "order_id", DataTypes.LongType,
                "product_id", DataTypes.LongType,
                "quantity", DataTypes.IntegerType,
                "unit_price", DataTypes.DoubleType
        );
        return spark.createDataFrame(List.of(rows), schema);
    }

    private Dataset<Row> products(Row... rows) {
        StructType schema = schema(
                "id", DataTypes.LongType,
                "name", DataTypes.StringType,
                "price", DataTypes.DoubleType,
                "category_id", DataTypes.LongType
        );
        return spark.createDataFrame(List.of(rows), schema);
    }

    private double popularityOf(Dataset<Row> result, long productId) {
        Row row = result.filter("product_id = " + productId).first();
        return row.getDecimal(row.fieldIndex("popularity_score")).doubleValue();
    }

    @Test
    void productNeverOrdered_shouldStillAppearWithZeroScore() {
        Dataset<Row> orders = orders();
        Dataset<Row> items = orderItems();
        Dataset<Row> products = products(RowFactory.create(10L, "Widget", 20.0, 1L));

        Dataset<Row> result = BatchAnalytics.productPopularity(orders, items, products, NOW, HALF_LIFE_DAYS);

        assertEquals(1, result.count());
        assertEquals(0.0, popularityOf(result, 10L), 1e-9);
    }

    @Test
    void orderSoldToday_shouldContributeApproximatelyItsFullQuantity() {
        Dataset<Row> orders = orders(RowFactory.create(1L, 100L, 50.0, "DELIVERED", "PAID", NOW));
        Dataset<Row> items = orderItems(RowFactory.create(1L, 1L, 10L, 4, 20.0));
        Dataset<Row> products = products(RowFactory.create(10L, "Widget", 20.0, 1L));

        Dataset<Row> result = BatchAnalytics.productPopularity(orders, items, products, NOW, HALF_LIFE_DAYS);

        // age = 0 days -> decay weight ~= 1.0 -> score ~= quantity (4)
        assertEquals(4.0, popularityOf(result, 10L), 1e-6);
    }

    @Test
    void orderSoldOneHalfLifeAgo_shouldContributeApproximatelyHalfItsQuantity() {
        Timestamp oneHalfLifeAgo = Timestamp.from(NOW.toInstant().minusSeconds((long) (HALF_LIFE_DAYS * 86400)));
        Dataset<Row> orders = orders(RowFactory.create(1L, 100L, 50.0, "DELIVERED", "PAID", oneHalfLifeAgo));
        Dataset<Row> items = orderItems(RowFactory.create(1L, 1L, 10L, 10, 20.0));
        Dataset<Row> products = products(RowFactory.create(10L, "Widget", 20.0, 1L));

        Dataset<Row> result = BatchAnalytics.productPopularity(orders, items, products, NOW, HALF_LIFE_DAYS);

        // age = exactly 1 half-life -> decay weight = 0.5 -> score ~= 5.0
        assertEquals(5.0, popularityOf(result, 10L), 1e-3);
    }

    @Test
    void recentSaleShouldOutweighALargerButOlderSale() {
        Timestamp twoHalfLivesAgo = Timestamp.from(NOW.toInstant().minusSeconds((long) (2 * HALF_LIFE_DAYS * 86400)));
        // Product 10: 3 units sold TODAY. Product 20: 100 units sold two half-lives ago (weight ~0.25 -> ~25).
        Dataset<Row> orders = orders(
                RowFactory.create(1L, 100L, 50.0, "DELIVERED", "PAID", NOW),
                RowFactory.create(2L, 101L, 50.0, "DELIVERED", "PAID", twoHalfLivesAgo)
        );
        Dataset<Row> items = orderItems(
                RowFactory.create(1L, 1L, 10L, 3, 20.0),
                RowFactory.create(2L, 2L, 20L, 100, 5.0)
        );
        Dataset<Row> products = products(
                RowFactory.create(10L, "Widget", 20.0, 1L),
                RowFactory.create(20L, "Old Bestseller", 5.0, 1L)
        );

        Dataset<Row> result = BatchAnalytics.productPopularity(orders, items, products, NOW, HALF_LIFE_DAYS);

        double recentSmallSale = popularityOf(result, 10L);
        double oldBigSale = popularityOf(result, 20L);

        // 3 * 1.0 = 3.0 vs 100 * 0.25 = 25.0 - the old sale still wins here (its
        // volume is large enough to overcome the decay), but the point of this
        // test is the RATIO: decay demonstrably reduced the old sale's weight
        // to about a quarter of its raw quantity, not that recency always wins
        // regardless of volume (it doesn't, and shouldn't).
        assertTrue(oldBigSale < 100.0 * 0.30 && oldBigSale > 100.0 * 0.20,
                "expected ~25.0 (100 * ~0.25 decay), got " + oldBigSale);
        assertEquals(3.0, recentSmallSale, 1e-3);
    }

    @Test
    void onlyPaidOrders_shouldContributeToPopularity() {
        Dataset<Row> orders = orders(
                RowFactory.create(1L, 100L, 50.0, "DELIVERED", "PAID", NOW),
                RowFactory.create(2L, 101L, 20.0, "CANCELLED", "UNPAID", NOW),
                RowFactory.create(3L, 102L, 40.0, "PENDING", "UNPAID", NOW)
        );
        Dataset<Row> items = orderItems(
                RowFactory.create(1L, 1L, 10L, 2, 20.0),
                RowFactory.create(2L, 2L, 10L, 50, 20.0), // CANCELLED/UNPAID - must be excluded
                RowFactory.create(3L, 3L, 10L, 50, 20.0)  // PENDING/UNPAID - must be excluded
        );
        Dataset<Row> products = products(RowFactory.create(10L, "Widget", 20.0, 1L));

        Dataset<Row> result = BatchAnalytics.productPopularity(orders, items, products, NOW, HALF_LIFE_DAYS);

        // Only the PAID order's 2 units should count, not the 50+50 from unpaid/cancelled orders.
        assertEquals(2.0, popularityOf(result, 10L), 1e-6);
    }

    @Test
    void invalidHalfLife_shouldThrow() {
        Dataset<Row> orders = orders();
        Dataset<Row> items = orderItems();
        Dataset<Row> products = products(RowFactory.create(10L, "Widget", 20.0, 1L));

        assertThrows(IllegalArgumentException.class,
                () -> BatchAnalytics.productPopularity(orders, items, products, NOW, 0.0));
        assertThrows(IllegalArgumentException.class,
                () -> BatchAnalytics.productPopularity(orders, items, products, NOW, -5.0));
    }
}
</file>

<file path="src/test/java/com/ecommerce/analytics/spark/streaming/StreamingAnalyticsTest.java">
package com.ecommerce.analytics.spark.streaming;

import com.ecommerce.analytics.spark.SparkTestSupport;
import org.apache.spark.sql.Dataset;
import org.apache.spark.sql.Row;
import org.apache.spark.sql.RowFactory;
import org.apache.spark.sql.types.DataTypes;
import org.apache.spark.sql.types.Metadata;
import org.apache.spark.sql.types.StructField;
import org.apache.spark.sql.types.StructType;
import org.junit.jupiter.api.Test;

import java.sql.Timestamp;
import java.util.List;
import java.util.Map;
import java.util.stream.Collectors;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertTrue;

/**
 * Verifies the JSON-parsing and window-bucketing/aggregation math against
 * ordinary static DataFrames (see StreamingAnalytics' class doc for why this
 * is a valid way to test Structured Streaming transformation logic without a
 * real Kafka broker). It does NOT verify incremental micro-batch execution
 * or watermark-based state eviction - only genuine streaming execution
 * exercises that, which is covered by the manual end-to-end run in
 * README.md instead.
 */
class StreamingAnalyticsTest extends SparkTestSupport {

    /** Builds a one-column ("value") DataFrame of raw JSON strings, mimicking Kafka's raw source schema. */
    private Dataset<Row> kafkaValues(String... jsonMessages) {
        StructType schema = new StructType(new StructField[]{
                new StructField("value", DataTypes.BinaryType, true, Metadata.empty())
        });
        List<Row> rows = new java.util.ArrayList<>();
        for (String json : jsonMessages) {
            rows.add(RowFactory.create((Object) json.getBytes(java.nio.charset.StandardCharsets.UTF_8)));
        }
        return spark.createDataFrame(rows, schema);
    }

    private static String orderCreated(String eventId, String occurredAt, long orderId, double total) {
        return """
                {"eventId":"%s","eventType":"ORDER_CREATED","occurredAt":"%s",
                 "aggregateType":"Order","aggregateId":%d,"version":1,
                 "payload":{"orderId":%d,"userId":7,"status":"PENDING","paymentStatus":"UNPAID",
                            "totalAmount":%s,"createdAt":"%s","items":[]}}
                """.formatted(eventId, occurredAt, orderId, orderId, total, occurredAt);
    }

    private static String paymentCreated(String eventId, String occurredAt, long orderId, double amount, String status) {
        return """
                {"eventId":"%s","eventType":"PAYMENT_CREATED","occurredAt":"%s",
                 "aggregateType":"Payment","aggregateId":%d,"version":1,
                 "payload":{"paymentId":1,"orderId":%d,"paymentMethod":"CARD","status":"%s",
                            "amount":%s,"transactionId":"txn-1","createdAt":"%s"}}
                """.formatted(eventId, occurredAt, orderId, orderId, status, amount, occurredAt);
    }

    @Test
    void parseEnvelope_shouldExtractEnvelopeAndPayloadFields() {
        Dataset<Row> raw = kafkaValues(
                orderCreated("e1", "2026-09-24T10:00:05Z", 100L, 59.98)
        );
        Row row = StreamingAnalytics.parseEnvelope(raw).collectAsList().get(0);

        assertEquals("e1", row.getAs("event_id"));
        assertEquals("ORDER_CREATED", row.getAs("event_type"));
        assertEquals("Order", row.getAs("aggregate_type"));
        assertEquals(100L, row.<Long>getAs("aggregate_id"));
        assertEquals(59.98, row.<Double>getAs("order_total_amount"), 0.001);
        // UTC instant, not Timestamp.valueOf (JVM-local-zone-dependent) - occurredAt
        // in the source JSON is "...05Z", a true UTC instant, so the parsed
        // event_time must be compared against an equally explicit UTC value.
        assertEquals(Timestamp.from(java.time.Instant.parse("2026-09-24T10:00:05Z")), row.getAs("event_time"));
    }

    @Test
    void parseEnvelope_shouldDropMessagesWithoutAParseableEventIdOrTime() {
        Dataset<Row> raw = kafkaValues("{\"not\":\"an envelope\"}");
        assertEquals(0, StreamingAnalytics.parseEnvelope(raw).count());
    }

    @Test
    void eventCountsByWindow_shouldBucketByOneMinuteTumblingWindowAndEventType() {
        Dataset<Row> raw = kafkaValues(
                orderCreated("e1", "2026-09-24T10:00:05Z", 100L, 10.0),
                orderCreated("e2", "2026-09-24T10:00:45Z", 101L, 10.0), // same minute as e1
                orderCreated("e3", "2026-09-24T10:01:05Z", 102L, 10.0), // next minute
                paymentCreated("e4", "2026-09-24T10:00:20Z", 100L, 10.0, "PAID") // same minute as e1, different type
        );
        Dataset<Row> parsed = StreamingAnalytics.parseEnvelope(raw);
        List<Row> result = StreamingAnalytics.eventCountsByWindow(parsed, "1 minute", "2 minutes").collectAsList();

        Map<String, Long> byTypeAndMinute = result.stream().collect(Collectors.toMap(
                r -> r.getAs("event_type") + "@" + r.getAs("window_start").toString(),
                r -> r.getAs("event_count")
        ));

        assertEquals(2L, byTypeAndMinute.get("ORDER_CREATED@2026-09-24 10:00:00.0"));
        assertEquals(1L, byTypeAndMinute.get("ORDER_CREATED@2026-09-24 10:01:00.0"));
        assertEquals(1L, byTypeAndMinute.get("PAYMENT_CREATED@2026-09-24 10:00:00.0"));
    }

    @Test
    void orderActivityByWindow_shouldSumTotalAmountOfOrderCreatedEventsOnly() {
        Dataset<Row> raw = kafkaValues(
                orderCreated("e1", "2026-09-24T10:00:05Z", 100L, 25.50),
                orderCreated("e2", "2026-09-24T10:00:45Z", 101L, 14.50),
                paymentCreated("e3", "2026-09-24T10:00:10Z", 100L, 25.50, "PAID") // must NOT count here
        );
        Dataset<Row> parsed = StreamingAnalytics.parseEnvelope(raw);
        List<Row> result = StreamingAnalytics.orderActivityByWindow(parsed, "1 minute", "2 minutes").collectAsList();

        assertEquals(1, result.size());
        Row window = result.get(0);
        assertEquals(2L, window.<Long>getAs("orders_created"));
        assertEquals(40.00, window.getDecimal(window.fieldIndex("gross_amount")).doubleValue(), 0.001);
    }

    @Test
    void paidRevenueByWindow_shouldOnlyCountPaymentsWithStatusPaid() {
        Dataset<Row> raw = kafkaValues(
                paymentCreated("e1", "2026-09-24T10:00:05Z", 100L, 30.0, "PAID"),
                paymentCreated("e2", "2026-09-24T10:00:10Z", 101L, 15.0, "FAILED"),
                paymentCreated("e3", "2026-09-24T10:00:15Z", 102L, 20.0, "PAID")
        );
        Dataset<Row> parsed = StreamingAnalytics.parseEnvelope(raw);
        List<Row> result = StreamingAnalytics.paidRevenueByWindow(parsed, "1 minute", "2 minutes").collectAsList();

        assertEquals(1, result.size());
        Row window = result.get(0);
        assertEquals(2L, window.<Long>getAs("paid_count")); // FAILED payment excluded
        assertEquals(50.00, window.getDecimal(window.fieldIndex("paid_revenue")).doubleValue(), 0.001);
    }
}
</file>

<file path="src/test/java/com/ecommerce/analytics/spark/SparkTestSupport.java">
package com.ecommerce.analytics.spark;

import org.apache.spark.sql.SparkSession;
import org.junit.jupiter.api.AfterAll;
import org.junit.jupiter.api.BeforeAll;

/** One shared local[*] SparkSession for the whole test run - creating a new one per test class is slow. */
public abstract class SparkTestSupport {

    protected static SparkSession spark;

    @BeforeAll
    static void startSpark() {
        // Fixes the SAME class of bug as spark.sql.session.timeZone below, but for
        // a different layer: java.sql.Timestamp.toString() (used when building
        // assertion values/map keys in these tests) is rendered using the JVM's
        // DEFAULT timezone, which is completely separate from Spark's own session
        // timeZone config. Without pinning this too, test assertions that compare
        // rendered strings are only correct on a UTC host machine.
        java.util.TimeZone.setDefault(java.util.TimeZone.getTimeZone("UTC"));

        spark = SparkSession.builder()
                .appName("spark-analytics-tests")
                .master("local[2]")
                .config("spark.sql.shuffle.partitions", "2")
                .config("spark.ui.enabled", "false")
                // Pinned to UTC deliberately: occurredAt (EventEnvelope) is a true
                // UTC Instant end-to-end, and hour()/to_date()/window() all operate
                // in Spark's SESSION timezone, not the JVM/host machine's default.
                // Without this, the exact same code produces different bucket
                // boundaries depending on which timezone the machine running it is
                // in - which is what caused the original failures (run on a
                // UTC+5:45 host, no pin -> everything silently shifted by 5:45).
                // See SparkAppConfig for the identical pin used by both real jobs.
                .config("spark.sql.session.timeZone", "UTC")
                .getOrCreate();
    }

    @AfterAll
    static void stopSpark() {
        if (spark != null) {
            spark.stop();
        }
    }
}
