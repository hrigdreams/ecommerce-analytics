<file path="src/utils/formatters.ts">
import { format } from 'date-fns';

/**
 * USD currency formatter for revenue figures (Spark trend/live-window
 * values). Whole-dollar precision -- these are aggregate revenue sums, not
 * unit prices, so cents are noise at this scale.
 */
export function formatCurrency(value: number): string {
  return new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: 'USD',
    maximumFractionDigits: 0,
  }).format(value);
}

/**
 * Compact number formatter for high-cardinality counters (salesCount,
 * popularityScore) -- e.g. 5200 -> "5.2K", 1_300_000 -> "1.3M".
 */
export function formatCompactNumber(value: number): string {
  return new Intl.NumberFormat('en-US', {
    notation: 'compact',
    maximumFractionDigits: 1,
  }).format(value);
}

/** Axis/table label for a Spark batch trend day, e.g. "2026-10-06" -> "Oct 6". */
export function formatDayLabel(isoDay: string): string {
  try {
    return format(new Date(isoDay), 'MMM d');
  } catch {
    return isoDay;
  }
}

/** Axis label for a live 1-minute sliding window timestamp, e.g. "14:05". */
export function formatWindowTime(isoTimestamp: string): string {
  try {
    return format(new Date(isoTimestamp), 'HH:mm');
  } catch {
    return isoTimestamp;
  }
}

/** Full timestamp for tooltips, where the truncated axis label isn't enough. */
export function formatFullTimestamp(isoTimestamp: string): string {
  try {
    return format(new Date(isoTimestamp), 'MMM d, HH:mm:ss');
  } catch {
    return isoTimestamp;
  }
}
