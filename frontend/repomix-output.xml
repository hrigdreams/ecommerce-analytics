import { useLocation } from 'react-router-dom';

const PAGE_TITLES: Record<string, { title: string; description: string }> = {
  '/': {
    title: 'Dashboard',
    description: 'Revenue and ranking signals across Spark and Postgres',
  },
  '/catalog': {
    title: 'Catalog',
    description: 'Live product search backed by Elasticsearch',
  },
  '/operations': {
    title: 'Operations',
    description: 'Trigger and verify backend event pipelines',
  },
};

/** Top bar: page title derived from the current route, plus a live-stream indicator. */
export function Header() {
  const { pathname } = useLocation();
  const page = PAGE_TITLES[pathname] ?? PAGE_TITLES['/'];

  return (
    <header className="sticky top-0 z-10 flex h-16 items-center justify-between border-b border-slate-200 bg-white/80 px-8 backdrop-blur">
      <div>
        <h1 className="text-base font-semibold text-slate-900">{page.title}</h1>
        <p className="text-xs text-slate-500">{page.description}</p>
      </div>

      <div className="flex items-center gap-2 rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1.5">
        <span className="relative flex h-2 w-2">
          <span className="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75" />
          <span className="relative inline-flex h-2 w-2 rounded-full bg-emerald-500" />
        </span>
        <span className="text-xs font-medium text-emerald-700">Live stream connected</span>
      </div>
    </header>
  );
}
