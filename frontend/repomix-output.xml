  return (
    <Badge variant={inStock ? 'success' : 'destructive'}>
      <span
        className={cn(
          'h-1.5 w-1.5 rounded-full',
          inStock ? 'bg-emerald-500' : 'bg-rose-500',
        )}
      />
      {inStock ? 'In stock' : 'Out of stock'}
    </Badge>
  );
}
