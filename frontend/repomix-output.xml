function ChartTooltip({
  active,
  payload,
  labelFormatter,
  valueKey,
}: {
  active?: boolean;
  payload?: { value: number; payload: Record<string, unknown> }[];
  labelFormatter: (point: Record<string, unknown>) => string;
  valueKey: string;
}) {
  if (!active || !payload?.length) return null;
  const point = payload[0].payload;
  return (
    <div className="rounded-md border border-slate-200 bg-white px-3 py-2 text-xs shadow-sm">
      <p className="font-medium text-slate-900">{labelFormatter(point)}</p>
      <p className="text-slate-500">{formatCurrency(Number(point[valueKey]))}</p>
    </div>
  );
}

/** Spark rows come back newest-first (ORDER BY ... DESC LIMIT); charts need oldest-first, left to right. */
function chronological<T>(rows: T[]): T[] {
  return [...rows].reverse();
}

/**
 * Every section of UnifiedAnalyticsResponse carries its own status: OK
 * (has data), EMPTY (job ran, table has no rows yet), or UNAVAILABLE (the
 * owning Spark job has never run -- the table doesn't exist). Surfacing
 * that distinction matters here: an UNAVAILABLE chart means "run the Spark
 * job", not "something is broken."
 */
function SectionNotice({ meta, jobHint }: { meta: SectionMeta; jobHint: string }) {
  if (meta.status === 'UNAVAILABLE') {
    return (
      <div className="flex h-[260px] flex-col items-center justify-center gap-1 text-center">
        <DatabaseZap className="h-6 w-6 text-slate-300" />
        <p className="text-sm text-slate-500">Not available yet.</p>
        <p className="text-xs text-slate-400">{jobHint}</p>
      </div>
    );
  }
  return (
    <div className="flex h-[260px] items-center justify-center text-sm text-slate-400">
      No rows yet.
    </div>
  );
}

function StatTile({
  icon,
  label,
  value,
}: {
  icon: ReactNode;
  label: string;
  value: string;
}) {
  return (
    <Card>
      <CardBody className="flex items-center gap-3">
        <div className="flex h-9 w-9 shrink-0 items-center justify-center rounded-md bg-slate-100 text-slate-500">
          {icon}
        </div>
        <div>
          <p className="text-xs text-slate-500">{label}</p>
          <p className="font-mono text-lg font-semibold text-slate-900">{value}</p>
        </div>
      </CardBody>
    </Card>
  );
}

