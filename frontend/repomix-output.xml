<file path="src/pages/CatalogPage.tsx">
import { useState } from 'react';
import { Search, PackageSearch, Flame } from 'lucide-react';
import { useProductSearch } from '../api/hooks';
import { Card, CardBody } from '../components/ui/Card';
import { StockBadge } from '../components/ui/Badge';
import { cn } from '../lib/utils';
import { formatCompactNumber } from '../utils/formatters';

export function CatalogPage() {
  const [query, setQuery] = useState('');
  const [categoryId, setCategoryId] = useState<number | null>(null);
  const { hits, totalHits, categoryBuckets, isLoading, isDebouncing } = useProductSearch(
    query,
    categoryId,
  );

  const showResults = query.trim().length > 0 || categoryId !== null;
  const showSpinner = isDebouncing || isLoading;

  return (
    <div className="space-y-6">
      <div className="relative">
        <Search className="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-slate-400" />
        <input
          type="text"
          value={query}
          onChange={(e) => setQuery(e.target.value)}
          placeholder="Search products by name -- typo-tolerant, backed by Elasticsearch"
          className="w-full rounded-lg border border-slate-200 bg-white py-4 pl-12 pr-12 text-base text-slate-900 shadow-sm outline-none transition-shadow placeholder:text-slate-400 focus:border-indigo-400 focus:ring-4 focus:ring-indigo-50"
        />
        {showSpinner && (
          <div className="absolute right-4 top-1/2 h-4 w-4 -translate-y-1/2 animate-spin rounded-full border-2 border-slate-300 border-t-indigo-500" />
        )}
      </div>

      {/* Category facet, built from this same response's categoryBuckets aggregation --
          only renders once a search has actually returned buckets to filter by. */}
      {categoryBuckets.length > 0 && (
        <div className="flex flex-wrap gap-2">
          <button
            onClick={() => setCategoryId(null)}
            className={cn(
              'rounded-full border px-3 py-1 text-xs font-medium transition-colors',
              categoryId === null
                ? 'border-slate-900 bg-slate-900 text-white'
                : 'border-slate-200 bg-white text-slate-600 hover:border-slate-300',
            )}
          >
            All categories
          </button>
          {categoryBuckets.map((bucket) => (
            <button
              key={bucket.categoryId}
              onClick={() => setCategoryId(bucket.categoryId)}
              className={cn(
                'rounded-full border px-3 py-1 text-xs font-medium transition-colors',
                categoryId === bucket.categoryId
                  ? 'border-slate-900 bg-slate-900 text-white'
                  : 'border-slate-200 bg-white text-slate-600 hover:border-slate-300',
              )}
            >
              Category {bucket.categoryId}
              <span className="ml-1 opacity-60">({bucket.docCount})</span>
            </button>
          ))}
        </div>
      )}

      {!showResults && (
        <Card>
          <CardBody className="flex flex-col items-center gap-2 py-16 text-center">
            <PackageSearch className="h-8 w-8 text-slate-300" />
            <p className="text-sm text-slate-500">
              Start typing to search the live product catalog.
            </p>
          </CardBody>
        </Card>
      )}

      {showResults && !isLoading && hits.length === 0 && (
        <Card>
          <CardBody className="flex flex-col items-center gap-2 py-16 text-center">
            <PackageSearch className="h-8 w-8 text-slate-300" />
            <p className="text-sm text-slate-500">
              {query.trim() ? `No products match "${query.trim()}".` : 'No products in this category.'}
            </p>
          </CardBody>
        </Card>
      )}

      {showResults && hits.length > 0 && (
        <>
          <p className="text-sm text-slate-500">
            {totalHits} {totalHits === 1 ? 'result' : 'results'}
          </p>
          <div className="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
            {hits.map((product) => (
              <Card key={product.id} className="transition-shadow hover:shadow-md">
                <CardBody className="space-y-3">
                  <div className="flex items-start justify-between gap-2">
                    <h3 className="text-sm font-semibold leading-snug text-slate-900">
                      {product.name}
                    </h3>
                    <StockBadge inStock={product.inStock} />
                  </div>

                  <div className="flex items-center justify-between border-t border-slate-100 pt-3">
                    <div>
                      <p className="text-xs text-slate-400">Sales</p>
                      <p className="font-mono text-lg font-semibold text-slate-900">
                        {formatCompactNumber(product.salesCount)}
                      </p>
                    </div>
                    <div className="text-right">
                      <p className="flex items-center justify-end gap-1 text-xs text-slate-400">
                        <Flame className="h-3 w-3" />
                        Popularity
                      </p>
                      <p className="font-mono text-sm text-slate-600">
                        {product.popularityScore.toFixed(2)}
                      </p>
                    </div>
                  </div>
                </CardBody>
              </Card>
            ))}
          </div>
        </>
      )}
    </div>
  );
}
</file>

